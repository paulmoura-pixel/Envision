# Published FlutterFlow web build of Envision (embedded on the Try Envision page).
VITE_ENVISION_WEB_URL=https://envision-8wd5is.flutterflow.app

# Base path the site is served from. For a GitHub Pages project site this is
# /Envision/. Use / for a user site (username.github.io) or a custom domain.
# The GitHub Actions workflow sets this automatically from the repository name.
VITE_BASE_PATH=/Envision/
